<?xml version="1.0" encoding="UTF-8"?>
<mcd version="2.0">
  <entities>
    <!-- Entité USER -->
    <entity name="USER" x="100" y="100">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="email" type="VARCHAR(255)" unique="true"/>
        <attribute name="password" type="VARCHAR(255)"/>
        <attribute name="first_name" type="VARCHAR(100)"/>
        <attribute name="last_name" type="VARCHAR(100)"/>
        <attribute name="phone" type="VARCHAR(20)"/>
        <attribute name="date_of_birth" type="DATE"/>
        <attribute name="address" type="VARCHAR(255)"/>
        <attribute name="city" type="VARCHAR(100)"/>
        <attribute name="country" type="VARCHAR(100)"/>
        <attribute name="postal_code" type="VARCHAR(20)"/>
        <attribute name="driver_license_number" type="VARCHAR(50)"/>
        <attribute name="license_issue_date" type="DATE"/>
        <attribute name="license_expiry_date" type="DATE"/>
        <attribute name="is_verified" type="BOOLEAN"/>
        <attribute name="is_active" type="BOOLEAN"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité LOYALTY_ACCOUNT -->
    <entity name="LOYALTY_ACCOUNT" x="400" y="100">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="user_id" type="INT" key="foreign"/>
        <attribute name="current_points" type="INT"/>
        <attribute name="lifetime_points" type="INT"/>
        <attribute name="tier_id" type="INT" key="foreign"/>
        <attribute name="tier_since" type="DATE"/>
        <attribute name="last_activity" type="DATE"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité LOYALTY_TIER -->
    <entity name="LOYALTY_TIER" x="700" y="100">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="name" type="VARCHAR(50)" unique="true"/>
        <attribute name="description" type="TEXT"/>
        <attribute name="min_points" type="INT"/>
        <attribute name="max_points" type="INT"/>
        <attribute name="discount_percentage" type="FLOAT"/>
        <attribute name="points_multiplier" type="INT"/>
        <attribute name="benefits" type="TEXT"/>
        <attribute name="color" type="VARCHAR(20)"/>
        <attribute name="icon" type="VARCHAR(100)"/>
        <attribute name="priority" type="INT"/>
      </attributes>
    </entity>

    <!-- Entité LOYALTY_TRANSACTION -->
    <entity name="LOYALTY_TRANSACTION" x="400" y="300">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="user_id" type="INT" key="foreign"/>
        <attribute name="loyalty_account_id" type="INT" key="foreign"/>
        <attribute name="booking_id" type="INT" key="foreign"/>
        <attribute name="transaction_type" type="VARCHAR(20)"/>
        <attribute name="points_amount" type="INT"/>
        <attribute name="description" type="VARCHAR(255)"/>
        <attribute name="expiry_date" type="DATE"/>
        <attribute name="is_expired" type="BOOLEAN"/>
        <attribute name="created_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité LOYALTY_REWARD -->
    <entity name="LOYALTY_REWARD" x="700" y="300">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="tier_id" type="INT" key="foreign"/>
        <attribute name="name" type="VARCHAR(100)"/>
        <attribute name="description" type="TEXT"/>
        <attribute name="points_required" type="INT"/>
        <attribute name="reward_type" type="VARCHAR(50)"/>
        <attribute name="discount_value" type="FLOAT"/>
        <attribute name="free_days" type="INT"/>
        <attribute name="validity_days" type="INT"/>
        <attribute name="is_active" type="BOOLEAN"/>
        <attribute name="created_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité CAR -->
    <entity name="CAR" x="100" y="500">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="registration_number" type="VARCHAR(50)" unique="true"/>
        <attribute name="vin_number" type="VARCHAR(50)" unique="true"/>
        <attribute name="brand_id" type="INT" key="foreign"/>
        <attribute name="model" type="VARCHAR(100)"/>
        <attribute name="year" type="INT"/>
        <attribute name="category_id" type="INT" key="foreign"/>
        <attribute name="color" type="VARCHAR(50)"/>
        <attribute name="seats" type="INT"/>
        <attribute name="transmission" type="VARCHAR(20)"/>
        <attribute name="fuel_type" type="VARCHAR(20)"/>
        <attribute name="daily_rate" type="FLOAT"/>
        <attribute name="weekly_rate" type="FLOAT"/>
        <attribute name="monthly_rate" type="FLOAT"/>
        <attribute name="mileage" type="INT"/>
        <attribute name="status" type="VARCHAR(20)"/>
        <attribute name="location" type="VARCHAR(255)"/>
        <attribute name="description" type="TEXT"/>
        <attribute name="features" type="TEXT"/>
        <attribute name="is_available" type="BOOLEAN"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité CAR_BRAND -->
    <entity name="CAR_BRAND" x="400" y="500">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="name" type="VARCHAR(100)" unique="true"/>
        <attribute name="logo_url" type="VARCHAR(255)"/>
        <attribute name="country" type="VARCHAR(100)"/>
      </attributes>
    </entity>

    <!-- Entité CAR_CATEGORY -->
    <entity name="CAR_CATEGORY" x="400" y="600">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="name" type="VARCHAR(100)" unique="true"/>
        <attribute name="description" type="TEXT"/>
        <attribute name="icon" type="VARCHAR(100)"/>
      </attributes>
    </entity>

    <!-- Entité BOOKING -->
    <entity name="BOOKING" x="100" y="800">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="user_id" type="INT" key="foreign"/>
        <attribute name="car_id" type="INT" key="foreign"/>
        <attribute name="start_date" type="DATE"/>
        <attribute name="end_date" type="DATE"/>
        <attribute name="pickup_time" type="TIME"/>
        <attribute name="return_time" type="TIME"/>
        <attribute name="pickup_location" type="VARCHAR(255)"/>
        <attribute name="return_location" type="VARCHAR(255)"/>
        <attribute name="total_days" type="INT"/>
        <attribute name="subtotal" type="FLOAT"/>
        <attribute name="insurance_cost" type="FLOAT"/>
        <attribute name="driver_cost" type="FLOAT"/>
        <attribute name="discount_amount" type="FLOAT"/>
        <attribute name="loyalty_discount" type="FLOAT"/>
        <attribute name="total_amount" type="FLOAT"/>
        <attribute name="loyalty_points_earned" type="INT"/>
        <attribute name="loyalty_points_used" type="INT"/>
        <attribute name="status_id" type="INT" key="foreign"/>
        <attribute name="insurance_id" type="INT" key="foreign"/>
        <attribute name="driver_id" type="INT" key="foreign"/>
        <attribute name="special_requests" type="TEXT"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité RENTAL_CONTRACT -->
    <entity name="RENTAL_CONTRACT" x="400" y="800">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="booking_id" type="INT" key="foreign"/>
        <attribute name="contract_number" type="VARCHAR(50)" unique="true"/>
        <attribute name="terms_and_conditions" type="TEXT"/>
        <attribute name="vehicle_condition" type="TEXT"/>
        <attribute name="odometer_start" type="INT"/>
        <attribute name="odometer_end" type="INT"/>
        <attribute name="fuel_level_start" type="VARCHAR(20)"/>
        <attribute name="fuel_level_end" type="VARCHAR(20)"/>
        <attribute name="damages_noted" type="TEXT"/>
        <attribute name="customer_signature" type="TEXT"/>
        <attribute name="agent_signature" type="TEXT"/>
        <attribute name="signed_at" type="DATETIME"/>
        <attribute name="pickup_datetime" type="DATETIME"/>
        <attribute name="return_datetime" type="DATETIME"/>
        <attribute name="status" type="VARCHAR(20)"/>
        <attribute name="notes" type="TEXT"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Entité CONTRACT_TEMPLATE -->
    <entity name="CONTRACT_TEMPLATE" x="700" y="800">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="name" type="VARCHAR(100)" unique="true"/>
        <attribute name="language" type="VARCHAR(10)"/>
        <attribute name="header_content" type="TEXT"/>
        <attribute name="body_content" type="TEXT"/>
        <attribute name="footer_content" type="TEXT"/>
        <attribute name="terms_standard" type="TEXT"/>
        <attribute name="terms_insurance" type="TEXT"/>
        <attribute name="terms_driver" type="TEXT"/>
        <attribute name="signature_section" type="TEXT"/>
        <attribute name="is_active" type="BOOLEAN"/>
        <attribute name="is_default" type="BOOLEAN"/>
        <attribute name="created_at" type="DATETIME"/>
        <attribute name="updated_at" type="DATETIME"/>
      </attributes>
    </entity>

    <!-- Autres entités simplifiées -->
    <entity name="INVOICE" x="100" y="1000">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="booking_id" type="INT" key="foreign"/>
        <attribute name="invoice_number" type="VARCHAR(50)" unique="true"/>
        <attribute name="issue_date" type="DATE"/>
        <attribute name="total_amount" type="FLOAT"/>
        <attribute name="status" type="VARCHAR(20)"/>
      </attributes>
    </entity>

    <entity name="PAYMENT" x="400" y="1000">
      <attributes>
        <attribute name="id" type="INT" key="primary"/>
        <attribute name="booking_id" type="INT" key="foreign"/>
        <attribute name="amount" type="FLOAT"/>
        <attribute name="payment_method" type="VARCHAR(50)"/>
        <attribute name="status" type="VARCHAR(20)"/>
      </attributes>
    </entity>

  </entities>

  <relationships>
    <relationship name="possede" entity1="USER" entity2="LOYALTY_ACCOUNT" cardinality1="1,1" cardinality2="0,N"/>
    <relationship name="appartient" entity1="LOYALTY_ACCOUNT" entity2="LOYALTY_TIER" cardinality1="0,N" cardinality2="1,1"/>
    <relationship name="fait" entity1="USER" entity2="BOOKING" cardinality1="1,1" cardinality2="0,N"/>
    <relationship name="reserve" entity1="BOOKING" entity2="CAR" cardinality1="0,N" cardinality2="1,1"/>
    <relationship name="genere_contrat" entity1="BOOKING" entity2="RENTAL_CONTRACT" cardinality1="1,1" cardinality2="1,1"/>
    <relationship name="utilise_template" entity1="RENTAL_CONTRACT" entity2="CONTRACT_TEMPLATE" cardinality1="0,N" cardinality2="0,1"/>
    <relationship name="genere_facture" entity1="BOOKING" entity2="INVOICE" cardinality1="1,1" cardinality2="1,1"/>
  </relationships>

</mcd>