{
  "name": "tomobilty",
  "version": "1.0.0",
  "description": "Plateforme de location de voitures au Maroc",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api:dev": "node api/index.js",
    "api:start": "node api/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:providers": "jest src/tests/providers/",
