{
  "name": "tommobilty",
  "version": "1.0.0",
  "description": "Plateforme de location de voitures au Maroc",
  "scripts": {
    "dev": "npm --prefix ./frontend run dev",
    "build": "cd frontend && npm install && npm run build",
    "start": "npm --prefix ./frontend run preview -- --host",
    "lint": "npm --prefix ./frontend run build",
    "api:dev": "npm run prisma:generate && node backend/api/index.js",
    "api:start": "npm run prisma:generate && node backend/api/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:providers": "jest tests/providers/",
    "prisma:generate": "prisma generate --schema ./backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./backend/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ./backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema ./backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^9.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.303.0",
    "modules": "^0.4.0",
    "multer": "^2.0.2",
    "next": "^14.0.4",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.0",
    "stripe": "^13.11.0",
    "tailwind-merge": "^2.2.0",
    "tesseract.js": "^6.0.1",
    "twilio": "^4.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.11",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/**/*.test.js",
      "!tests/**"
    ]
  }
}
