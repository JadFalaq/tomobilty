generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                @id @default(autoincrement())
  nom                        String?            @db.VarChar(100)
  prenom                     String?            @db.VarChar(100)
  email                      String             @unique @db.VarChar(255)
  telephone                  String?            @db.VarChar(20)
  mot_de_passe               String?            @db.VarChar(255)
  role                       Role               @default(CLIENT)
  email_verified             Boolean            @default(false)
  phone_verified             Boolean            @default(false)
  email_verification_token   String?            @db.VarChar(255)
  email_verification_expires DateTime?
  date_creation              DateTime           @default(now())
  date_modification          DateTime           @default(now()) @updatedAt
  bookings                   Booking[]
  chatConversations          ChatConversation[]
  invoices                   Invoice[]
  loyaltyAccount             LoyaltyAccount?
  notifications              Notification[]
  oauthAccounts              OauthAccount[]
  payments                   Payment[]
  refreshTokens              RefreshToken[]
  reviews                    Review[]
  adminSettings              AdminSettings?

  @@map("users")
}

model OauthAccount {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  provider            String   @db.VarChar(50)
  provider_account_id String   @db.VarChar(255)
  created_at          DateTime @default(now())
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@map("oauth_accounts")
}

model PhoneVerification {
  id         Int      @id @default(autoincrement())
  phone      String   @db.VarChar(20)
  code       String   @db.VarChar(10)
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  @@map("phone_verifications")
}

// Enum corrigé
enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS      // ← AJOUTÉ
  REFUNDED   // ← AJOUTÉ
}

enum PaymentMode {
  EN_LIGNE
  EN_AGENCE
  @@map("payment_mode")
}

// Type de protection
enum ProtectionType {
  BASIQUE
  COMPLETE
  PREMIUM
  @@map("protection_type")
}

model Protection {
  id              Int             @id @default(autoincrement())
  type            ProtectionType
  frais_par_jour  Decimal         @db.Decimal(10, 2)
  proprietes      Json
  created_at      DateTime        @default(now())
  bookings        Booking[]

  @@map("protection")
}

// Modèle loyalty_tier avec les nouveaux champs
model LoyaltyTier {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(50)
  min_points        Int              // ← Valeurs corrigées dans la DB
  max_points        Int?             // ← AJOUTÉ (optionnel)
  discount_percent  Decimal          @db.Decimal(5, 2)
  points_multiplier Decimal          @default(1.0) @db.Decimal(3, 1) // ← AJOUTÉ
  benefits          String?
  created_at        DateTime         @default(now())
  loyaltyAccounts   LoyaltyAccount[]

  @@map("loyalty_tier")
}

// Modèle loyalty_account mis à jour
model LoyaltyAccount {
  id             Int                  @id @default(autoincrement())
  user_id        Int                  @unique
  points_balance Int                  @default(0)  // Points actuels
  lifetime_points Int                 @default(0)  // Total points gagnés (pour upgrade)
  tier_id        Int                  @default(1)
  total_spent    Decimal              @default(0) @db.Decimal(10, 2)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt
  tier           LoyaltyTier          @relation(fields: [tier_id], references: [id])
  user           User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  @@map("loyalty_account")
}

model LoyaltyReward {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  description  String?
  points_cost  Int
  reward_type  String   @db.VarChar(50)
  reward_value Decimal? @db.Decimal(10, 2)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  @@map("loyalty_reward")
}

model LoyaltyTransaction {
  id                  Int                     @id @default(autoincrement())
  loyalty_account_id  Int
  booking_id          Int?
  type                LoyaltyTransactionType
  points              Int
  description         String?
  created_at          DateTime                @default(now())
  
  loyaltyAccount      LoyaltyAccount          @relation(fields: [loyalty_account_id], references: [id], onDelete: Cascade)
  booking             Booking?                @relation(fields: [booking_id], references: [id])

  @@map("loyalty_transaction")
}

model Car {
  id                Int           @id @default(autoincrement())
  brand_id          Int
  category_id       Int
  modele            String        @db.VarChar(50)
  transmission      String?       @db.VarChar(20)
  nombre_places     Int?
  nombre_portes     Int?
  prix_par_jour     Decimal       @db.Decimal(10, 2)
  statut            CarStatus     @default(DISPONIBLE)
  date_creation     DateTime      @default(now())
  date_modification DateTime      @default(now()) @updatedAt
  brand             CarBrand      @relation(fields: [brand_id], references: [id])
  category          CarCategory   @relation(fields: [category_id], references: [id])
  images            CarImage[]
  variantes         VarianteCar[]

  @@map("car")
}

model VarianteCar {
  id               Int            @id @default(autoincrement())
  car_id           Int
  immatriculation  String         @unique @db.VarChar(20)
  couleur          String?        @db.VarChar(30)
  type_carburant   enum_carburant
  kilometrage      Int            @default(0)
  description      String?
  ville            String         @db.VarChar(100)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @default(now()) @updatedAt

  car              Car            @relation(fields: [car_id], references: [id], onDelete: Cascade)
  maintenances     Maintenance[]
  bookings         Booking[]

  @@map("variante_car")
}

model CarBrand {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(50)
  logo_url   String?  @db.VarChar(500)
  created_at DateTime @default(now())
  cars       Car[]

  @@map("car_brand")
}

model CarCategory {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique @db.VarChar(50)
  description         String?
  created_at          DateTime            @default(now())
  cars                Car[]
  promotionCategories PromotionCategory[]

  @@map("car_category")
}

model CarImage {
  id         Int      @id @default(autoincrement())
  car_id     Int
  image_url  String   @db.VarChar(500)
  alt_text   String?  @db.VarChar(255)
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  car        Car      @relation(fields: [car_id], references: [id], onDelete: Cascade)

  @@map("car_image")
}

model Booking {
  id                   Int                  @id @default(autoincrement())
  user_id              Int
  variante_car_id      Int
  date_debut           DateTime
  date_fin             DateTime
  lieu_prise_en_charge String?              @db.VarChar(255)
  lieu_retour          String?              @db.VarChar(255)
  prix_total           Decimal              @db.Decimal(10, 2)
  caution_payee        Decimal              @default(0) @db.Decimal(10, 2)
  status_id            Int                  @default(1)
  status_name          BookingStatusName    @default(EN_ATTENTE)
  mode_paiement        PaymentMode?         @default(EN_LIGNE)
  protection_id        Int?
  protection           Protection?          @relation(fields: [protection_id], references: [id])
  metadata             String?
  date_creation        DateTime             @default(now())
  date_modification    DateTime             @default(now()) @updatedAt
  varianteCar          VarianteCar          @relation(fields: [variante_car_id], references: [id], onDelete: Cascade)
  status               BookingStatus        @relation(fields: [status_id], references: [id])
  user                 User                 @relation(fields: [user_id], references: [id])
  invoices             Invoice[]
  loyaltyTransactions  LoyaltyTransaction[]
  payments             Payment[]

  @@map("booking")
}

enum BookingStatusName {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ANNULE

  @@map("booking_status_name")
}

model BookingStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  created_at  DateTime  @default(now())
  bookings    Booking[]

  @@map("booking_status")
}

// Removed tables: AdditionalDriver, RentalContract, ContractTemplate

model Payment {
  id                  Int           @id @default(autoincrement())
  booking_id          Int
  user_id             Int
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("MAD") @db.VarChar(5)
  status              PaymentStatus @default(CREATED)
  provider            String        @default("stripe") @db.VarChar(20)
  provider_session_id String?       @db.VarChar(255)
  provider_payment_id String?       @db.VarChar(255)
  metadata            String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @default(now()) @updatedAt
  invoices            Invoice[]
  booking             Booking       @relation(fields: [booking_id], references: [id])
  user                User          @relation(fields: [user_id], references: [id])

  @@map("payment")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  user_id        Int
  booking_id     Int
  payment_id     Int?
  invoice_number String        @unique @db.VarChar(50)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("MAD") @db.VarChar(5)
  status         InvoiceStatus @default(PENDING)
  pdf_path       String?       @db.VarChar(500)
  metadata       String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now()) @updatedAt
  booking        Booking       @relation(fields: [booking_id], references: [id])
  payment        Payment?      @relation(fields: [payment_id], references: [id])
  user           User          @relation(fields: [user_id], references: [id])

  @@map("invoice")
}

model Insurance {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?
  coverage    String
  price       Decimal  @db.Decimal(10, 2)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  @@map("insurance")
}

// Removed table: Driver

model Review {
  id          Int      @id @default(autoincrement())
  user_id     Int
  car_id      Int?
  rating      Int      @db.SmallInt
  comment     String?
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id])

  @@map("review")
}

model Maintenance {
  id               Int               @id @default(autoincrement())
  variante_car_id  Int
  maintenance_type MaintenanceType
  description      String
  cost             Decimal?          @db.Decimal(10, 2)
  scheduled_date   DateTime          @db.Date
  completed_date   DateTime?         @db.Date
  status           MaintenanceStatus @default(SCHEDULED)
  created_at       DateTime          @default(now())
  varianteCar      VarianteCar       @relation(fields: [variante_car_id], references: [id], onDelete: Cascade)

  @@map("maintenance")
}

// Removed table: Document

model Admin {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  permissions String
  created_at  DateTime @default(now())

  @@map("admin")
}

model AdminSettings {
  id                        Int      @id @default(autoincrement())
  user_id                   Int      @unique
  language                  String?  @default("fr") @db.VarChar(10)
  timezone                  String?  @default("Africa/Casablanca") @db.VarChar(50)
  notification_email        Boolean  @default(true)
  notification_sms          Boolean  @default(false)
  dashboard_default_range   String?  @default("7d") @db.VarChar(10)
  created_at                DateTime @default(now())
  updated_at                DateTime @default(now()) @updatedAt
  user                      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("admin_settings")
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  title      String           @db.VarChar(255)
  message    String
  type       NotificationType
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification")
}

model Promotion {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(100)
  description String?
  discount    Decimal             @db.Decimal(5, 2)
  start_date  DateTime            @db.Date
  end_date    DateTime            @db.Date
  is_active   Boolean             @default(true)
  created_at  DateTime            @default(now())
  categories  PromotionCategory[]

  @@map("promotion")
}

model PromotionCategory {
  id           Int         @id @default(autoincrement())
  promotion_id Int
  category_id  Int
  category     CarCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  promotion    Promotion   @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, category_id])
  @@map("promotion_category")
}

model PickupSite {
  id         Int      @id @default(autoincrement())
  nom        String   @db.VarChar(255) @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("pickup_site")
}

model ChatConversation {
  id         Int           @id @default(autoincrement())
  user_id    Int?
  session_id String        @unique @default(uuid()) @db.Uuid
  status     String        @default("active") @db.VarChar(20)
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  user       User?         @relation(fields: [user_id], references: [id])
  messages   ChatMessage[]

  @@map("chat_conversation")
}

model ChatMessage {
  id              Int              @id @default(autoincrement())
  conversation_id Int
  sender          String           @db.VarChar(20)
  message         String
  message_type    String           @default("text") @db.VarChar(50)
  metadata        String?
  created_at      DateTime         @default(now())
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("chat_message")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  admin_id    Int
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   Int?
  old_values  String?
  new_values  String?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([admin_id])
  @@index([entity_type])
  @@index([created_at])
  @@map("audit_logs")
}

model SystemSetting {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(100)
  value      String
  category   String   @db.VarChar(50)
  updated_at DateTime @default(now()) @updatedAt
  updated_by Int?

  @@map("system_settings")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  user_id     Int
  token_hash  String   @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id])
  @@index([user_id])
  @@map("refresh_token")
}

enum Role {
  CLIENT
  ADMIN
  AGENT

  @@map("role")
}


enum CarStatus {
  DISPONIBLE
  LOUE
  MAINTENANCE
  INDISPONIBLE

  @@map("car_status")
}

enum PaymentStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
  CLEANING

  @@map("maintenance_type")
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("maintenance_status")
}

enum DocumentStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("document_status")
}

enum NotificationType {
  BOOKING
  PAYMENT
  SYSTEM
  PROMOTION

  @@map("notification_type")
}

enum enum_carburant {
  DIESEL
  ESSENCE
  ELECTRIQUE
  HYBRIDE

  @@map("carburant")
}
