# Configuration pour Docker
NODE_ENV=production

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:password123@postgres:5432/tomobilty

# JWT Secret (changez ceci en production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-environment

# URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Ports
PORT=5000
NEXT_PORT=3000

# PostgreSQL Credentials
POSTGRES_DB=tomobilty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
